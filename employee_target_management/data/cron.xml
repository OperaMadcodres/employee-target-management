<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="ir_cron_calculate_employee_targets"
            model="ir.cron">

        <field name="name">Calculate Employee Target Achievement</field>

        <field name="model_id"
               ref="model_employee_target"/>

        <field name="state">code</field>

        <field name="code">
model.search([
    ('status', '=', 'active')
]).action_calculate_achievement()
        </field>

        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>

        <field name="active">True</field>

    </record>

</odoo>