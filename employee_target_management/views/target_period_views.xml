<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Target Period List -->
    <record id="view_employee_target_period_list" model="ir.ui.view">
        <field name="name">employee.target.period.list</field>
        <field name="model">employee.target.period</field>

        <field name="arch" type="xml">
            <list string="Target Periods">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- Target Period Form -->
    <record id="view_employee_target_period_form" model="ir.ui.view">
        <field name="name">employee.target.period.form</field>
        <field name="model">employee.target.period</field>

        <field name="arch" type="xml">
            <form string="Target Period">

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="e.g. August 2026"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="description"/>
                        </group>
                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Target Period Action -->
    <record id="action_employee_target_period"
            model="ir.actions.act_window">

        <field name="name">Target Periods</field>
        <field name="res_model">employee.target.period</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>