<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Target Type List View -->
    <record id="view_employee_target_type_list" model="ir.ui.view">
        <field name="name">employee.target.type.list</field>
        <field name="model">employee.target.type</field>
        <field name="arch" type="xml">
            <list string="Target Types">
                <field name="name"/>
                <field name="code"/>
                <field name="measurement_type"/>
                <field name="achievement_source"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- Target Type Form View -->
    <record id="view_employee_target_type_form" model="ir.ui.view">
        <field name="name">employee.target.type.form</field>
        <field name="model">employee.target.type</field>
        <field name="arch" type="xml">
            <form string="Target Type">

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Sales Amount"/>
                        </h1>
                    </div>

                    <group>

                        <group>
                            <field name="code"/>
                            <field name="measurement_type"/>
                            <field name="achievement_source"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="description"
                                   placeholder="Describe this target type..."/>
                        </group>

                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Target Type Action -->
    <record id="action_employee_target_type" model="ir.actions.act_window">
        <field name="name">Target Types</field>
        <field name="res_model">employee.target.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Target Type
            </p>
            <p>
                Target Types define what employees are measured against.
            </p>
        </field>
    </record>

</odoo>