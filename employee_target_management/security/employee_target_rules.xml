<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ============================================================
         Target User - Own Employee Targets
         ============================================================ -->

    <record id="rule_employee_target_user_own"
            model="ir.rule">

        <field name="name">
            Employee Target: User Own Targets
        </field>

        <field name="model_id"
               ref="model_employee_target"/>

        <field name="groups"
               eval="[(4, ref('group_employee_target_user'))]"/>

        <field name="domain_force">
            [('employee_id.user_id', '=', user.id)]
        </field>

    </record>


    <!-- ============================================================
         Target Manager - All Targets
         ============================================================ -->

    <record id="rule_employee_target_manager_all"
            model="ir.rule">

        <field name="name">
            Employee Target: Manager All Targets
        </field>

        <field name="model_id"
               ref="model_employee_target"/>

        <field name="groups"
               eval="[(4, ref('group_employee_target_manager'))]"/>

        <field name="domain_force">
            [(1, '=', 1)]
        </field>

    </record>

</odoo> 